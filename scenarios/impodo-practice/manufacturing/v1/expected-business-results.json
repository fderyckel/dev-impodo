  "declared_from": "Manufacturing business answers in docs/plans/24-shared-practice-data, declared before the runnable manufacturing harness.",
  "identity_policy": {
    "product.category": {
      "fields": [
        "name"
      ],
      "scope_fields": [
        "parent_id"
      ],
      "parent_identity_recursive": true
    },
    "product.template": {
      "fields": [
        "default_code"
      ],
      "scope_fields": []
    },
    "product.product": {
      "fields": [
        "default_code"
      ],
      "scope_fields": []
    },
    "mrp.bom": {
      "fields": [
        "code"
      ],
      "scope_fields": [],
      "governed_globally_unique_for_this_corpus": true,
      "company_assignment_required": true
    },
    "mrp.bom.line": {
      "fields": [
        "sequence"
      ],
      "scope_fields": [
        "bom_id"
      ]
    },
    "mrp.routing.workcenter": {
      "fields": [
        "name"
      ],
      "scope_fields": [
        "bom_id"
      ],
      "sequence_is_ordering_not_identity": true
    }
  },
  "repeat_contract": "After successful completion, authoring repeat and Recipe over either business-identical delivery must create 0 and update 0. All mapped rows are unchanged, including 12 categories in each product workspace.",
  "source_only": {
    "products_core": [
      "RecId",
      "CategoryLevel1",
      "CategoryLevel2",
      "CategoryLevel3"
    ],
    "product_details": [
      "Name",
      "Status",
      "Weight",
      "ModifiedAtUS",
      "ModifiedAtISO",
      "EmptyExportNote"
    ],
    "categories": [
      "CategoryKey",
      "Code",
      "Active"
    ],
    "bom_rows": [
      "HeaderName",
      "LineRef",
      "QuantitySeries",
      "ValidFromText"
    ],
    "bom_operations": [
      "OperationRef"
    ],
    "meaning": "Source identity and trace columns can be used by preparation without becoming target writes. Dates and weight have no target field in this baseline. CategoryKey is the source category link; native category identity is recursive name and parent. BoM headers are supplied as a separate six-row export. Repeated header cells in bom_rows remain raw export evidence and are not used to derive or select header records at runtime.",
    "bom_headers": [
      "HeaderName"
    ]
  },
