        <dc:Bounds x="1330" y="190" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SaveCapturePlan" bpmnElement="Task_SaveCapturePlan">
        <dc:Bounds x="1530" y="420" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_OdooCapturePlan" bpmnElement="End_OdooCapturePlan">
        <dc:Bounds x="1730" y="437" width="36" height="36" />
      </bpmndi:BPMNShape>
