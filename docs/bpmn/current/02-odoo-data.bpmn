      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_OdooSourceMode" bpmnElement="Gateway_OdooSourceMode" isMarkerVisible="true">
        <dc:Bounds x="1220" y="120" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_BusinessKeys" bpmnElement="Task_BusinessKeys">
        <dc:Bounds x="1330" y="80" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ConfirmSchema" bpmnElement="Task_ConfirmSchema">
