<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_LoadOdoo" targetNamespace="https://impodo.dev/bpmn/current" exporter="Impodo documentation generator" exporterVersion="1.0">
  <bpmn:process id="Process_LoadOdoo" name="Load into Odoo" isExecutable="false">
    <bpmn:documentation>Current disposable-target execution, read-back reconciliation, and scalar completed-load correction workflow.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_LoadOdoo">
      <bpmn:lane id="Lane_DataManager" name="Data manager">
        <bpmn:flowNodeRef>Start_Load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewLoad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExplicitLoad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fallout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fallout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyCorrection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Impodo" name="Impodo">
        <bpmn:flowNodeRef>Task_ShowPreview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Writes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NoWrite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoWrite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Current</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Stale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Journal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Transport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordUnknown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreBatches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SealCorrectionOrigin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CorrectionNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reconciled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CorrectionSafe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CorrectionBlocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CorrectionVerified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Load" name="Current READY report">
      <bpmn:outgoing>Flow_LOAD_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ShowPreview" name="Show target, hash, totals, fields, and dependency order">
      <bpmn:incoming>Flow_LOAD_01</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Writes" name="Any writes?">
      <bpmn:incoming>Flow_LOAD_02</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_LOAD_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NoWrite" name="Record unchanged completion">
      <bpmn:incoming>Flow_LOAD_03</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_NoWrite" name="Complete; no writes">
      <bpmn:incoming>Flow_LOAD_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ReviewLoad" name="Review preview and provide separate write key">
      <bpmn:incoming>Flow_LOAD_05</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ExplicitLoad" name="Select Load into Odoo once">
      <bpmn:incoming>Flow_LOAD_06</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Revalidate" name="Revalidate snapshot, target, actor, permissions, and key bindings">
      <bpmn:incoming>Flow_LOAD_07</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Current" name="All bindings current?">
      <bpmn:incoming>Flow_LOAD_08</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_LOAD_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Stale" name="Stop before target I/O">
      <bpmn:incoming>Flow_LOAD_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Journal" name="Commit run and planned row attempts">
      <bpmn:incoming>Flow_LOAD_10</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Write" name="Execute bounded dependency-ordered write batch">
      <bpmn:incoming>Flow_LOAD_11</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_12</bpmn:outgoing>
      <bpmn:incoming>Flow_LOAD_19</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Transport" name="Transport outcome?">
      <bpmn:incoming>Flow_LOAD_12</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_LOAD_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_LOAD_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RecordAccepted" name="Record accepted result">
      <bpmn:incoming>Flow_LOAD_13</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RecordRejected" name="Record rejected or partial result">
      <bpmn:incoming>Flow_LOAD_14</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RecordUnknown" name="Record outcome unknown and stop later writes">
      <bpmn:incoming>Flow_LOAD_15</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MoreBatches" name="More reviewed batches?">
      <bpmn:incoming>Flow_LOAD_16</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_LOAD_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReadBack" name="Read back exact affected records">
      <bpmn:incoming>Flow_LOAD_17</bpmn:incoming>
      <bpmn:incoming>Flow_LOAD_18</bpmn:incoming>
      <bpmn:incoming>Flow_LOAD_20</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Reconcile" name="Publish immutable reconciliation result">
      <bpmn:incoming>Flow_LOAD_21</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Verified" name="Expected target state proved?">
      <bpmn:incoming>Flow_LOAD_22</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_LOAD_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SealCorrectionOrigin" name="Seal exact completed-load correction origin">
      <bpmn:incoming>Flow_LOAD_23</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CorrectionNeeded" name="Correction needed later?">
      <bpmn:incoming>Flow_LOAD_26</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_LOAD_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Reconciled" name="Reconciled complete">
      <bpmn:incoming>Flow_LOAD_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Fallout" name="Review fallout; do not blindly retry">
      <bpmn:incoming>Flow_LOAD_24</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Fallout" name="Needs attention">
      <bpmn:incoming>Flow_LOAD_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_EditCorrection" name="Change the incorrect matching rules">
      <bpmn:incoming>Flow_LOAD_28</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ReviewCorrection" name="Prepare with Polars and compare changed scalar intent by exact ID">
      <bpmn:incoming>Flow_LOAD_29</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CorrectionSafe" name="Blocker-free correction?">
      <bpmn:incoming>Flow_LOAD_30</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_LOAD_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_CorrectionBlocked" name="Correction needs attention">
      <bpmn:incoming>Flow_LOAD_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ApplyCorrection" name="Confirm Apply N corrections">
      <bpmn:incoming>Flow_LOAD_32</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ExecuteCorrection" name="Reread, journal, update exact fields, and verify">
      <bpmn:incoming>Flow_LOAD_33</bpmn:incoming>
      <bpmn:outgoing>Flow_LOAD_34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_CorrectionVerified" name="Correction verified">
      <bpmn:incoming>Flow_LOAD_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_LOAD_01" sourceRef="Start_Load" targetRef="Task_ShowPreview" />
    <bpmn:sequenceFlow id="Flow_LOAD_02" sourceRef="Task_ShowPreview" targetRef="Gateway_Writes" />
    <bpmn:sequenceFlow id="Flow_LOAD_03" sourceRef="Gateway_Writes" targetRef="Task_NoWrite" name="No" />
    <bpmn:sequenceFlow id="Flow_LOAD_04" sourceRef="Task_NoWrite" targetRef="End_NoWrite" />
    <bpmn:sequenceFlow id="Flow_LOAD_05" sourceRef="Gateway_Writes" targetRef="Task_ReviewLoad" name="Yes" />
    <bpmn:sequenceFlow id="Flow_LOAD_06" sourceRef="Task_ReviewLoad" targetRef="Task_ExplicitLoad" />
    <bpmn:sequenceFlow id="Flow_LOAD_07" sourceRef="Task_ExplicitLoad" targetRef="Task_Revalidate" />
    <bpmn:sequenceFlow id="Flow_LOAD_08" sourceRef="Task_Revalidate" targetRef="Gateway_Current" />
    <bpmn:sequenceFlow id="Flow_LOAD_09" sourceRef="Gateway_Current" targetRef="End_Stale" name="No" />
    <bpmn:sequenceFlow id="Flow_LOAD_10" sourceRef="Gateway_Current" targetRef="Task_Journal" name="Yes" />
    <bpmn:sequenceFlow id="Flow_LOAD_11" sourceRef="Task_Journal" targetRef="Task_Write" />
    <bpmn:sequenceFlow id="Flow_LOAD_12" sourceRef="Task_Write" targetRef="Gateway_Transport" />
    <bpmn:sequenceFlow id="Flow_LOAD_13" sourceRef="Gateway_Transport" targetRef="Task_RecordAccepted" name="Accepted" />
    <bpmn:sequenceFlow id="Flow_LOAD_14" sourceRef="Gateway_Transport" targetRef="Task_RecordRejected" name="Rejected or partial" />
    <bpmn:sequenceFlow id="Flow_LOAD_15" sourceRef="Gateway_Transport" targetRef="Task_RecordUnknown" name="Timeout or lost response" />
    <bpmn:sequenceFlow id="Flow_LOAD_16" sourceRef="Task_RecordAccepted" targetRef="Gateway_MoreBatches" />
    <bpmn:sequenceFlow id="Flow_LOAD_17" sourceRef="Task_RecordRejected" targetRef="Task_ReadBack" />
    <bpmn:sequenceFlow id="Flow_LOAD_18" sourceRef="Task_RecordUnknown" targetRef="Task_ReadBack" />
    <bpmn:sequenceFlow id="Flow_LOAD_19" sourceRef="Gateway_MoreBatches" targetRef="Task_Write" name="Yes" />
    <bpmn:sequenceFlow id="Flow_LOAD_20" sourceRef="Gateway_MoreBatches" targetRef="Task_ReadBack" name="No" />
    <bpmn:sequenceFlow id="Flow_LOAD_21" sourceRef="Task_ReadBack" targetRef="Task_Reconcile" />
    <bpmn:sequenceFlow id="Flow_LOAD_22" sourceRef="Task_Reconcile" targetRef="Gateway_Verified" />
    <bpmn:sequenceFlow id="Flow_LOAD_23" sourceRef="Gateway_Verified" targetRef="Task_SealCorrectionOrigin" name="Yes" />
    <bpmn:sequenceFlow id="Flow_LOAD_24" sourceRef="Gateway_Verified" targetRef="Task_Fallout" name="No" />
    <bpmn:sequenceFlow id="Flow_LOAD_25" sourceRef="Task_Fallout" targetRef="End_Fallout" />
    <bpmn:sequenceFlow id="Flow_LOAD_26" sourceRef="Task_SealCorrectionOrigin" targetRef="Gateway_CorrectionNeeded" />
    <bpmn:sequenceFlow id="Flow_LOAD_27" sourceRef="Gateway_CorrectionNeeded" targetRef="End_Reconciled" name="No" />
    <bpmn:sequenceFlow id="Flow_LOAD_28" sourceRef="Gateway_CorrectionNeeded" targetRef="Task_EditCorrection" name="Yes" />
    <bpmn:sequenceFlow id="Flow_LOAD_29" sourceRef="Task_EditCorrection" targetRef="Task_ReviewCorrection" />
    <bpmn:sequenceFlow id="Flow_LOAD_30" sourceRef="Task_ReviewCorrection" targetRef="Gateway_CorrectionSafe" />
    <bpmn:sequenceFlow id="Flow_LOAD_31" sourceRef="Gateway_CorrectionSafe" targetRef="End_CorrectionBlocked" name="No" />
    <bpmn:sequenceFlow id="Flow_LOAD_32" sourceRef="Gateway_CorrectionSafe" targetRef="Task_ApplyCorrection" name="Yes" />
    <bpmn:sequenceFlow id="Flow_LOAD_33" sourceRef="Task_ApplyCorrection" targetRef="Task_ExecuteCorrection" />
    <bpmn:sequenceFlow id="Flow_LOAD_34" sourceRef="Task_ExecuteCorrection" targetRef="End_CorrectionVerified" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Process_LoadOdoo">
    <bpmn:participant id="Participant_Process_LoadOdoo" name="Load into Odoo" processRef="Process_LoadOdoo" />
    <bpmn:participant id="Participant_Odoo" name="Exact Odoo 19 target" />
    <bpmn:messageFlow id="Message_LOAD_Write" name="Supported Odoo 19 API write" sourceRef="Task_Write" targetRef="Participant_Odoo" />
    <bpmn:messageFlow id="Message_LOAD_WriteResponse" name="Write response" sourceRef="Participant_Odoo" targetRef="Task_Write" />
    <bpmn:messageFlow id="Message_LOAD_ReadBack" name="Read exact affected scope" sourceRef="Task_ReadBack" targetRef="Participant_Odoo" />
    <bpmn:messageFlow id="Message_LOAD_ReadBackResponse" name="Current record state" sourceRef="Participant_Odoo" targetRef="Task_ReadBack" />
    <bpmn:messageFlow id="Message_LOAD_CorrectionRead" name="Read changed-intent fields by exact ID" sourceRef="Task_ReviewCorrection" targetRef="Participant_Odoo" />
    <bpmn:messageFlow id="Message_LOAD_CorrectionWrite" name="Bounded exact-ID scalar updates and read-back" sourceRef="Task_ExecuteCorrection" targetRef="Participant_Odoo" />
  </bpmn:collaboration>
