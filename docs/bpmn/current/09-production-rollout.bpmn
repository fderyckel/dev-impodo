      <bpmndi:BPMNShape id="Shape_Task_PR_Check" bpmnElement="Task_PR_Check">
        <dc:Bounds x="1370" y="330" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_PR_Ready" bpmnElement="Gateway_PR_Ready" isMarkerVisible="true">
        <dc:Bounds x="1600" y="340" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PR_Recover" bpmnElement="Task_PR_Recover">
        <dc:Bounds x="1720" y="110" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PR_Activate" bpmnElement="Task_PR_Activate">
        <dc:Bounds x="1720" y="330" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PR_Applications" bpmnElement="Task_PR_Applications">
        <dc:Bounds x="1950" y="110" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PR_Guard" bpmnElement="Task_PR_Guard">
        <dc:Bounds x="2180" y="330" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_PR_Verified" bpmnElement="Gateway_PR_Verified" isMarkerVisible="true">
        <dc:Bounds x="2410" y="340" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_PR_Attention" bpmnElement="End_PR_Attention">
        <dc:Bounds x="2530" y="127" width="36" height="36" />
