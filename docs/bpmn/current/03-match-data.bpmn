<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_MatchData" targetNamespace="https://impodo.dev/bpmn/current" exporter="Impodo documentation generator" exporterVersion="1.0">
  <bpmn:process id="Process_MatchData" name="Match data" isExecutable="false">
    <bpmn:documentation>Current file-source mapping authoring, validation, impact review, and confirmation workflow.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_MatchData">
      <bpmn:lane id="Lane_DataManager" name="Data manager">
        <bpmn:flowNodeRef>Start_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DatasetMode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MapFields</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MapRules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MapRelations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewImpact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MappingValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseMapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmMapping</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Impodo" name="Impodo">
        <bpmn:flowNodeRef>Task_CheckMapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Impact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishMapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Match</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Match" name="Source and Odoo data complete">
      <bpmn:outgoing>Flow_MAP_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_DatasetMode" name="Choose dataset target mode and identity">
      <bpmn:incoming>Flow_MAP_01</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MapFields" name="Map writable values and deliberate omissions">
      <bpmn:incoming>Flow_MAP_02</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MapRules" name="Configure transformations and selection values">
      <bpmn:incoming>Flow_MAP_03</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MapRelations" name="Map relations with portable keys">
      <bpmn:incoming>Flow_MAP_04</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SaveDraft" name="Save mapping draft">
      <bpmn:incoming>Flow_MAP_05</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_06</bpmn:outgoing>
      <bpmn:incoming>Flow_MAP_11</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CheckMapping" name="Validate exact mapping revision">
      <bpmn:incoming>Flow_MAP_06</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Impact" name="Publish transformation impact">
      <bpmn:incoming>Flow_MAP_07</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewImpact" name="Review findings and rule effects">
      <bpmn:incoming>Flow_MAP_08</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MappingValid" name="Blocking finding?">
      <bpmn:incoming>Flow_MAP_09</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_MAP_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviseMapping" name="Revise mapping">
      <bpmn:incoming>Flow_MAP_10</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmMapping" name="Confirm field matches">
      <bpmn:incoming>Flow_MAP_12</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_PublishMapping" name="Publish immutable confirmed revision">
      <bpmn:incoming>Flow_MAP_13</bpmn:incoming>
      <bpmn:outgoing>Flow_MAP_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Match" name="Match data complete">
      <bpmn:incoming>Flow_MAP_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MAP_01" sourceRef="Start_Match" targetRef="Task_DatasetMode" />
    <bpmn:sequenceFlow id="Flow_MAP_02" sourceRef="Task_DatasetMode" targetRef="Task_MapFields" />
    <bpmn:sequenceFlow id="Flow_MAP_03" sourceRef="Task_MapFields" targetRef="Task_MapRules" />
    <bpmn:sequenceFlow id="Flow_MAP_04" sourceRef="Task_MapRules" targetRef="Task_MapRelations" />
    <bpmn:sequenceFlow id="Flow_MAP_05" sourceRef="Task_MapRelations" targetRef="Task_SaveDraft" />
    <bpmn:sequenceFlow id="Flow_MAP_06" sourceRef="Task_SaveDraft" targetRef="Task_CheckMapping" />
    <bpmn:sequenceFlow id="Flow_MAP_07" sourceRef="Task_CheckMapping" targetRef="Task_Impact" />
    <bpmn:sequenceFlow id="Flow_MAP_08" sourceRef="Task_Impact" targetRef="Task_ReviewImpact" />
    <bpmn:sequenceFlow id="Flow_MAP_09" sourceRef="Task_ReviewImpact" targetRef="Gateway_MappingValid" />
    <bpmn:sequenceFlow id="Flow_MAP_10" sourceRef="Gateway_MappingValid" targetRef="Task_ReviseMapping" name="Yes" />
    <bpmn:sequenceFlow id="Flow_MAP_11" sourceRef="Task_ReviseMapping" targetRef="Task_SaveDraft" name="Recheck" />
    <bpmn:sequenceFlow id="Flow_MAP_12" sourceRef="Gateway_MappingValid" targetRef="Task_ConfirmMapping" name="No" />
    <bpmn:sequenceFlow id="Flow_MAP_13" sourceRef="Task_ConfirmMapping" targetRef="Task_PublishMapping" />
    <bpmn:sequenceFlow id="Flow_MAP_14" sourceRef="Task_PublishMapping" targetRef="End_Match" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Process_MatchData">
    <bpmn:participant id="Participant_Process_MatchData" name="Match data" processRef="Process_MatchData" />
  </bpmn:collaboration>
