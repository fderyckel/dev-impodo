      <bpmndi:BPMNShape id="Shape_Task_ReplaceFile" bpmnElement="Task_ReplaceFile">
        <dc:Bounds x="900" y="190" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_FreezeTables" bpmnElement="Task_FreezeTables">
        <dc:Bounds x="1050" y="330" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_RelatedPlan" bpmnElement="Gateway_RelatedPlan" isMarkerVisible="true">
        <dc:Bounds x="1250" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RelatedPlan" bpmnElement="Task_RelatedPlan">
        <dc:Bounds x="1360" y="80" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_FileSource" bpmnElement="End_FileSource">
        <dc:Bounds x="1560" y="97" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DefineOdooSelection" bpmnElement="Task_DefineOdooSelection">
        <dc:Bounds x="370" y="190" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviewEstimate" bpmnElement="Task_ReviewEstimate">
        <dc:Bounds x="570" y="190" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CaptureOdoo" bpmnElement="Task_CaptureOdoo">
        <dc:Bounds x="770" y="420" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PublishOdooSource" bpmnElement="Task_PublishOdooSource">
        <dc:Bounds x="990" y="420" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_OdooSource" bpmnElement="End_OdooSource">
        <dc:Bounds x="1210" y="437" width="36" height="36" />
      </bpmndi:BPMNShape>
