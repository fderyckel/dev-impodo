      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IQ_Check" bpmnElement="Task_IQ_Check">
        <dc:Bounds x="910" y="330" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_IQ_Ready" bpmnElement="Gateway_IQ_Ready" isMarkerVisible="true">
        <dc:Bounds x="1140" y="340" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IQ_Recover" bpmnElement="Task_IQ_Recover">
        <dc:Bounds x="1260" y="110" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IQ_Qualify" bpmnElement="Task_IQ_Qualify">
        <dc:Bounds x="1260" y="210" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IQ_Publish" bpmnElement="Task_IQ_Publish">
        <dc:Bounds x="1480" y="330" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_IQ_Select" bpmnElement="Gateway_IQ_Select" isMarkerVisible="true">
        <dc:Bounds x="1700" y="120" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IQ_Select" bpmnElement="Task_IQ_Select">
        <dc:Bounds x="1830" y="90" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IQ_Record" bpmnElement="Task_IQ_Record">
        <dc:Bounds x="2040" y="330" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_IQ_Selected" bpmnElement="End_IQ_Selected">
        <dc:Bounds x="2260" y="347" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_IQ_Qualified" bpmnElement="End_IQ_Qualified">
        <dc:Bounds x="1850" y="217" width="36" height="36" />
      </bpmndi:BPMNShape>
