  "field_capability_checks": [
    "Resolve payment-term header identity from approved captured fields. TermCode is a source key, not a promise that Odoo has a code field.",
    "Use child account.payment.term.line ownership and captured due-date fields. Never infer 45-day terms from the parent name.",
    "Verify company behavior for each model against the verified Odoo major and shared reference policies.",
    "Verify account.account code/company and parent relationship fields. ParentCode is proposed business intent and does not promise a standard Odoo parent field.",
    "Verify optional date destination fields. The CSV supports date parsing; native Excel-cell coverage is a separate future artifact.",
    "Reseed initial target per exercise or record the full prior exercise state. Do not add exercise classification totals together.",
    "Customer CompanyCode scopes the exercise and accounting choices. The declared customer intent does not assign res.partner.company_id; explicit record ownership would be a separate reviewed exercise."
  ],
  "operation_company_policy": "Exactly one selected operation company per load/run. Run NORTH and SOUTH projections separately, with explicit source row filters; shared records retain their declared shared ownership.",
  "required_model_capabilities": {
    "disposable_only": true,
    "connection": "LOCAL or REMOTE must be explicitly verified for the chosen target and major.",
