# Python bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tmp/
.coverage
coverage.xml
htmlcov/

# Local Python environments and packaging output
.venv/
venv/
env/
.python/
.uv-cache/
.tools/
.env
.env.*
!.env.example
build/
dist/
*.egg-info/

# Generated review packages
outputs/

# Local migration projects and customer data
var/
.codex-artifacts

# Local Git worktrees
# Keep disposable worktrees under .local-worktrees/ (or the existing .tmp/),
# never as top-level repository content. These paths are retained as ignore
# rules because they were previously committed accidentally.
/.local-worktrees/
/r/
/t/
/u/
/v/
/w/
/x/

# OS and editor files
.DS_Store
.idea/
.vscode/
/.agents/
