    },
    {
      "legacy_field": "Recipe.retention_days",
      "target_owner": "MigrationProject.retention_policy",
      "disposition": "Make the Project authoritative. A Recipe may retain a derived governance projection."
    },
    {
      "legacy_field": "DataVersion.recipe_id",
      "target_owner": "DataVersion.project_id",
      "disposition": "Replace Recipe ownership with immutable Project ownership."
    },
    {
      "legacy_field": "DataVersion.workspace_project_id",
      "target_owner": "MigrationWorkspace.data_version_id",
      "disposition": "Remove the one-workspace pointer. Several isolated workspaces may consume one DataVersion."
    },
    {
      "legacy_field": "DataVersion.pinned_recipe_revision",
      "target_owner": "RecipeApplication.recipe_revision",
      "disposition": "Remove the package-level Recipe pin. Each application selects one exact revision."
    },
    {
      "legacy_field": "DataVersion.parameter_values_hash",
      "target_owner": "RecipeApplication.parameter_values_hash",
      "disposition": "Move Recipe-specific values to the exact application. Project package context remains on DataVersion."
    },
    {
      "legacy_field": "RecipeApplication.workspace_project_id",
      "target_owner": "RecipeApplication.workspace_id",
      "disposition": "Rename the internal workspace identity and keep it distinct from the business Project."
    },
    {
      "legacy_field": "RecipeApplication.target_binding_hash",
      "target_owner": "MigrationRun.target_binding_id",
      "disposition": "Let the run own one target binding. Each application references the exact binding and hash."
    },
    {
      "legacy_field": "RecipeApplication.credential_generation",
      "target_owner": "MigrationRun.TargetBinding.credential_generation",
      "disposition": "Capture credential evidence once per run and project a bounded reference into each application."
    },
    {
      "legacy_field": "RecipeApplication.source_selection_hash",
      "target_owner": "DataVersion.source_package_hash",
      "disposition": "Let DataVersion own the complete accepted package. The application owns only its physical binding hash."
    },
    {
      "legacy_field": "RecipeQualification",
      "target_owner": "CutoverPlanQualification",
      "disposition": "Retain per-Recipe evidence as a component and qualify the exact integrated Test plan at Project level."
    },
    {
      "legacy_field": "CutoverCandidate",
      "target_owner": "MigrationProject.project_cutover_selection",
      "disposition": "Replace the Recipe candidate with one exact Project-level qualified plan selection."
    },
    {
      "legacy_field": "RecipeIntent.recipe_id",
      "target_owner": "Owner-specific operation intents",
      "disposition": "Use the identifier of the aggregate that owns each operation instead of one universal Recipe coordinator."
    },
    {
      "legacy_field": "WorkspaceResolution.recipe_id",
